# Copy to frontend/.env.local. Only VITE_* vars are exposed to the browser — never put secrets here.

# Leave blank in dev (Vite proxies /api to localhost:4000).
# For a deployed build, set to the ApiUrl output from the SAM deploy.
VITE_API_URL=

# Public Jamendo client ID for music search; copy into frontend/.env.local.
VITE_JAMENDO_CLIENT_ID=
