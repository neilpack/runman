# Copy to frontend/.env.local. Only VITE_* vars are exposed to the browser — never put secrets here.

# Leave blank in dev (Vite proxies /api to localhost:4000).
# Retained local example API only; do not deploy SAM for the Learner Lab auth path.
VITE_API_URL=

# Public Jamendo client ID for music search; copy into frontend/.env.local.
VITE_JAMENDO_CLIENT_ID=

# Cognito public IDs live in cognito-config.json, copied from its example JSON.
# No AWS keys, lab session tokens, client secrets, or LabRole credentials here.
