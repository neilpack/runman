# Template only: copy settings into the ignored backend environment file.
# Never fill this committed example with secrets, tokens, or AWS credentials.
# Default disabled. Memory requires exact NODE_ENV=development and no AWS markers.
CASSETTE_STORAGE_MODE=disabled
COGNITO_USER_POOL_ID=
COGNITO_USER_POOL_CLIENT_ID=
AWS_REGION=us-west-2
# Existing table name; only used when mode=dynamodb. This creates no resources.
CASSETTES_TABLE=
# Supply a secret generated outside source control (at least 32 random bytes,
# e.g. encoded as hex/base64). Do not reuse public pool/client IDs as a secret.
CASSETTE_CURSOR_SECRET=
