# Copy to backend/.env and fill in. Never commit .env.

PORT=4000
# Examples require NODE_ENV=development AND ENABLE_LEGACY_EXAMPLES=true exactly.
# Keep the flag false unless using local examples; never put private data here.
NODE_ENV=development
ENABLE_LEGACY_EXAMPLES=false
# Production, AWS execution markers, and the Lambda entry point always disable
# /api/items, even if the flag is true. /api/health remains available.
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173

# --- AWS ---
AWS_REGION=us-east-1
# Use a named profile from ~/.aws/credentials (run `aws configure --profile runman`)
# or export AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY instead.
AWS_PROFILE=runman

# Leave blank to use the in-memory store (no AWS needed for local dev).
ITEMS_TABLE=
# S3 bucket for uploads (optional)
UPLOADS_BUCKET=
