# Copy to backend/.env and fill in. Never commit .env.

PORT=4000
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173

# --- AWS ---
AWS_REGION=us-east-1
# Use a named profile from ~/.aws/credentials (run `aws configure --profile runman`)
# or export AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY instead.
AWS_PROFILE=runman

# Leave blank to use the in-memory store (no AWS needed for local dev).
ITEMS_TABLE=
# S3 bucket for uploads (optional)
UPLOADS_BUCKET=

# --- Jamendo ---
# Required for the music search endpoint. Never commit the real client ID.
JAMENDO_CLIENT_ID=
# Optional; useful for local testing against a compatible API.
JAMENDO_API_URL=https://api.jamendo.com/v3.0
