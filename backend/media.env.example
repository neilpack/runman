# Template only. Copy settings into ignored server environment; no browser credentials.
# Default disabled. Requires existing Cognito/cassette DynamoDB configuration.
MEDIA_STORAGE_MODE=disabled
# After separate manual configuration and approval, use MEDIA_STORAGE_MODE=s3.
# A separate private versioned SSE-S3 bucket in the same AWS_REGION is required.
# It MUST differ from Explore's public UPLOADS_BUCKET. No fallback bucket is used.
PRIVATE_AUDIO_BUCKET=
# CASSETTE_STORAGE_MODE=dynamodb, CASSETTES_TABLE, COGNITO_USER_POOL_ID,
# COGNITO_USER_POOL_CLIENT_ID and AWS_REGION reuse backend cassette configuration.
# LabRole stays server-side. No deletion, TTL or lifecycle cleanup is implemented.
